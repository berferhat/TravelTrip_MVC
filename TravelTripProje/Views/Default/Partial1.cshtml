@using TravelTripProje.Models.Siniflar
@model List<Blog>

<div class="row con-bot">
    @foreach (var x in Model)
    {
        <div class="left">
            <div class="bot-left">
                <img src="@x.BlogImage"/>
            </div>
            <div class="left-text">
                <h4>@x.Baslik</h4>
                <span class="doller">@x.Tarih.ToShortDateString()</span>
                <p>@(x.Aciklama.Length > 150 ? x.Aciklama.Substring(0, 150) + "..." : x.Aciklama)</p>
                <p><a href="/Blog/BlogDetay/@x.ID"> <span class="read">Devamını Oku >></span> </a></p>
            </div>
        </div>
    }
    <div class="clear"></div>
</div>