@using TravelTripProje.Models.Siniflar
@model List<Blog>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<!--
Author: W3layouts
Author URL: http://w3layouts.com
License: Creative Commons Attribution 3.0 Unported
License URL: http://creativecommons.org/licenses/by/3.0/
-->
<!DOCTYPE HTML>
<html>

<body>
    <div class="header-banner">
        <div class="wrap">
            <div class="banner">
                <div class="indent">
                    <h2 class="indent-left margin-bot">Tatil & Seyahat Bloğum</h2>
                    <div class="banner-wrapper">
                        <div class="banner-left">
                            <div class="con-text">
                                <div class="grid1-img">
                                    <img src="~/web/images/glass.png" alt="">
                                </div>
                                <div class="grid1-desc">
                                    <p>Restoranlar</p>
                                </div>
                                <div class="clear"></div>
                            </div>
                            <div class="con-text">
                                <div class="grid1-img">
                                    <img src="~/web/images/flight.png" alt="">
                                </div>
                                <div class="grid1-desc">
                                    <p>Uçuşlar</p>
                                </div>
                                <div class="clear"></div>
                            </div>
                            <div class="con-text">
                                <div class="grid1-img">
                                    <img src="~/web/images/group.png" alt="">
                                </div>
                                <div class="grid1-desc">
                                    <p>Yapılacaklar</p>
                                </div>
                                <div class="clear"></div>
                            </div>
                            <div class="con-text">
                                <div class="grid1-img">
                                    <img src="~/web/images/key.png" alt="">
                                </div>
                                <div class="grid1-desc">
                                    <p>Araç Kiralama</p>
                                </div>
                                <div class="clear"></div>
                            </div>
                            <div class="clear"></div>
                        </div>
                        <div class="header_bottom_right_images">

                            <div class="slider">
                                <ul class="rslides" id="slider1">
                                    @foreach (var x in Model)
                                    {
                                        <li><img src="@x.BlogImage" alt=""></li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clear"></div>
            </div>
            <div class="clear"></div>
        </div>
    </div>
    <div class="content">
        <div class="wrap">
            <div class="wrapper">
                <div class="con-top">
                    <h3>Tatil Seyahat Bloğuma Hoşgeldiniz!</h3>
                    <p>
                        Pasaportunuzu yanınıza aldıysanız ve yeni rotaların heyecanı kalbinizi çarptırıyorsa, tam olmanız gereken yerdesiniz! Bu blok; sadece gidilen yerlerin değil, o yerlerde hissedilen duyguların, tadılan lezzetlerin ve biriktirilen eşsiz anıların paylaşıldığı bir gezi günlüğü.
                        Roma’nın antik taşlarından Lyon’un gurme mutfaklarına, Eyfel’in ışıltısından dünyanın hiç bilinmedik köşelerine kadar her durakta farklı bir hikaye anlatıyoruz. Amacım, size sadece rehberlik etmek değil, aynı zamanda bir sonraki seyahatiniz için o ilk kıvılcımı çakmak.
                        Bavulunuzu hazırlayın; birlikte görecek çok yerimiz, keşfedecek çok yolumuz var. Şimdiden keyifli keşifler!
                    </p>
                </div>

                @Html.Action("Partial1", "Default")
               

                <div class="grids">
                    <div class="box1">

                        @Html.Action("Partial3", "Default")

                        @Html.Action("Partial4", "Default")

                        <div class="clear"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>


