@using TravelTripProje.Models.Siniflar
@model List<Blog>


<div class="padding">
    <h4>En Popüler 10 Blog</h4>
    <ul class="list list-pad">
        @{ int i = 1; }
        @foreach (var x in Model)
        {
            <li class="@(i % 2 == 1 ? "list-bg" : "list-bg1")">
                <span>@(i).</span>
                <a href="/Blog/BlogDetay/@x.ID">@x.Baslik</a>
            </li>
            i++;
        }
    </ul>
    <a href="/Blog/Index/" class="link1">Tüm Blogları Gör</a>
</div>
